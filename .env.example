# Environnement local Docker Compose (docs/runbooks/environnement-local.md).
#
#   cp .env.example .env
#
# Valeurs factices, pour le poste de développement et la CI seulement : elles sont publiques
# (dans le dépôt) et ne doivent servir nulle part ailleurs. La préproduction et la production ont
# leurs propres secrets, chiffrés par SOPS sur le serveur (T-068). Ne commitez jamais `.env`.
#
# Format simple CLE=valeur, sans guillemets ni espaces : lu par Docker Compose et par `. ./.env`.

# PostgreSQL 18
LIGNEE_PG_PORT=5432
LIGNEE_PG_SUPERUSER_PASSWORD=local-only-postgres-superuser
LIGNEE_DB_MIGRATION_PASSWORD=local-only-lignee-migration
LIGNEE_DB_APP_PASSWORD=local-only-lignee-app

# MinIO, à la place de Cloudflare R2
LIGNEE_MINIO_PORT=9000
LIGNEE_MINIO_CONSOLE_PORT=9001
LIGNEE_MINIO_ROOT_USER=lignee-local-admin
LIGNEE_MINIO_ROOT_PASSWORD=local-only-minio-root
LIGNEE_S3_BUCKET=lignee-medias-local
LIGNEE_S3_ACCESS_KEY_ID=lignee-app-local
LIGNEE_S3_SECRET_ACCESS_KEY=local-only-s3-app-secret

# API (profil app)
LIGNEE_API_PORT=3000

{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "globalDependencies": ["tsconfig.base.json", "eslint.config.mjs"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "lint": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "@lignee/ci#test": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/compose.yaml",
        "$TURBO_ROOT$/.env.example",
        "$TURBO_ROOT$/.dockerignore",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "$TURBO_ROOT$/packages/db/initdb/**",
        "$TURBO_ROOT$/apps/*/Dockerfile"
      ],
      "outputs": []
    },
    "@lignee/ui#test": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/docs/charte/tokens.json",
        "$TURBO_ROOT$/docs/charte/*.md",
        "$TURBO_ROOT$/docs/charte/fonts/**",
        "$TURBO_ROOT$/.prettierrc*"
      ],
      "outputs": []
    },
    "//#format:write": {
      "cache": false
    },
    "//#format:verify": {
      "cache": false
    }
  }
}

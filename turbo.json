{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "globalDependencies": ["tsconfig.base.json", "eslint.config.mjs"],
  "globalEnv": ["LIGNEE_PERF_FACTOR", "LIGNEE_DEVICE_SLOWDOWN"],
  "globalPassThroughEnv": ["CI"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "lint": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["transit"],
      "outputs": [],
      "passThroughEnv": ["LIGNEE_SCENARIOS_PLAYED_DIR"]
    },
    "test:budget": {
      "cache": false,
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/test/scenarios/**"],
      "outputs": [],
      "passThroughEnv": ["LIGNEE_SCENARIOS_PLAYED_DIR"]
    },
    "@lignee/domain#test": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/test/scenarios/**",
        "$TURBO_ROOT$/docs/cahier-des-charges/cahier-des-charges-4-cas-limites.md",
        "$TURBO_ROOT$/docs/plan/v1-decoupage.md"
      ],
      "outputs": [],
      "passThroughEnv": ["LIGNEE_SCENARIOS_PLAYED_DIR"]
    },
    "@lignee/sync#test": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/test/scenarios/**"],
      "outputs": [],
      "passThroughEnv": ["LIGNEE_SCENARIOS_PLAYED_DIR"]
    },
    "@lignee/layout#test": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/test/scenarios/**"],
      "outputs": [],
      "passThroughEnv": ["LIGNEE_SCENARIOS_PLAYED_DIR"]
    },
    "@lignee/ci#test": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/compose.yaml",
        "$TURBO_ROOT$/.env.example",
        "$TURBO_ROOT$/.dockerignore",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "$TURBO_ROOT$/packages/db/initdb/**",
        "$TURBO_ROOT$/apps/*/Dockerfile",
        "$TURBO_ROOT$/apps/*/app.config.*",
        "$TURBO_ROOT$/apps/*/app.json",
        "$TURBO_ROOT$/apps/*/plugins/**",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/apps/mobile/package.json"
      ],
      "outputs": [],
      "passThroughEnv": ["LIGNEE_SCENARIOS_PLAYED_DIR"]
    },
    "@lignee/ui#test": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/docs/charte/tokens.json",
        "$TURBO_ROOT$/docs/charte/*.md",
        "$TURBO_ROOT$/docs/charte/fonts/**",
        "$TURBO_ROOT$/.prettierrc*"
      ],
      "outputs": []
    },
    "//#format:write": {
      "cache": false
    },
    "//#format:verify": {
      "cache": false
    }
  }
}
